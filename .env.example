# PharmaSentry AI — environment configuration template.
# Copy to `.env` and fill in real values. Never commit `.env`.
# This is an educational prototype: only synthetic data belongs in this system.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-value

# --- LLM provider ---
# LLM_PROVIDER: "mock" (deterministic, offline, used in CI/tests) or "anthropic"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30

# --- Database ---
# DB_BACKEND: "sqlite" (local fallback) or "postgres"
DB_BACKEND=sqlite
SQLITE_PATH=./data/pharmasentry.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pharmasentry
POSTGRES_USER=pharmasentry
POSTGRES_PASSWORD=

# --- Retrieval ---
VECTOR_INDEX_PATH=./data/vector_index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_PROVIDER: "deterministic" (offline, default, used in CI/tests) or
# "sentence_transformers" (real semantic embeddings; requires the optional
# sentence-transformers dependency)
EMBEDDING_PROVIDER=deterministic
BM25_INDEX_PATH=./data/bm25_index

# --- OCR ---
# OCR_PROVIDER: "local" (pytesseract fallback) or a configured cloud adapter name
OCR_PROVIDER=local

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PORT=9090
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Governance / limits ---
MAX_DELEGATION_DEPTH=6
MAX_AGENT_RETRIES=1
MAX_RUNTIME_SECONDS=300
MAX_TOKENS_PER_CASE=200000
RETENTION_DAYS=90
